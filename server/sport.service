[Unit]
Description=sport-dnevnik (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sport/server
Environment=GROQ_API_KEY=ВСТАВЬ_КЛЮЧ_GROQ
ExecStart=/opt/sport/server/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
